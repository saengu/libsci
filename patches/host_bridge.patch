diff --git a/libsci/src/sci/impl/LibSciHost.java b/libsci/src/sci/impl/LibSciHost.java
new file mode 100644
index 0000000..873fc1f
--- /dev/null
+++ b/libsci/src/sci/impl/LibSciHost.java
@@ -0,0 +1,49 @@
+package sci.impl;
+
+import org.graalvm.nativeimage.c.function.CEntryPoint;
+import org.graalvm.nativeimage.c.type.CCharPointer;
+import org.graalvm.nativeimage.c.type.CConst;
+import org.graalvm.nativeimage.c.type.CTypeConversion;
+
+import java.util.UUID;
+import java.util.concurrent.ConcurrentHashMap;
+
+public final class LibSciHost {
+
+    private static final ConcurrentHashMap<String, String> pendingCalls = new ConcurrentHashMap<>();
+    private static final ConcurrentHashMap<String, String> callResults = new ConcurrentHashMap<>();
+
+    public static String registerCall(String argsJson) {
+        String id = UUID.randomUUID().toString();
+        pendingCalls.put(id, argsJson);
+        return id;
+    }
+
+    public static String consumeResult(String id) {
+        return callResults.remove(id);
+    }
+
+    @CEntryPoint(name = "get_pending_host_call")
+    public static @CConst CCharPointer getPendingHostCall(
+            @CEntryPoint.IsolateThreadContext long tid,
+            @CConst CCharPointer idCStr) {
+        String id = CTypeConversion.toJavaString(idCStr);
+        String data = pendingCalls.get(id);
+        if (data == null) data = "{\"status\":\"not_found\"}";
+        CTypeConversion.CCharPointerHolder h = CTypeConversion.toCString(data);
+        return h.get();
+    }
+
+    @CEntryPoint(name = "deliver_host_call_result")
+    public static @CConst CCharPointer deliverHostCallResult(
+            @CEntryPoint.IsolateThreadContext long tid,
+            @CConst CCharPointer idCStr,
+            @CConst CCharPointer resultCStr) {
+        String id = CTypeConversion.toJavaString(idCStr);
+        String result = CTypeConversion.toJavaString(resultCStr);
+        pendingCalls.remove(id);
+        callResults.put(id, result);
+        CTypeConversion.CCharPointerHolder h = CTypeConversion.toCString("{\"status\":\"ok\"}");
+        return h.get();
+    }
+}
diff --git a/libsci/src/sci/impl/libsci_host.clj b/libsci/src/sci/impl/libsci_host.clj
new file mode 100644
index 0000000..9e15603
--- /dev/null
+++ b/libsci/src/sci/impl/libsci_host.clj
@@ -0,0 +1,75 @@
+(ns sci.impl.libsci-host
+  (:require [cheshire.core :as json]
+            [sci.core :as sci])
+  (:gen-class
+   :methods [^{:static true} [loadScript     [String] String]
+             ^{:static true} [callFunction   [String String] String]
+             ^{:static true} [evalInContext  [String] String]
+             ^{:static true} [resetContext   [] void]]))
+
+(defonce contexts (atom {}))
+
+(defn- get-ctx []
+  (get @contexts (.getId (Thread/currentThread))))
+
+(defn- set-ctx! [ctx]
+  (swap! contexts assoc (.getId (Thread/currentThread)) ctx))
+
+(defn- register-host-call [args-json]
+  (let [cls  (Class/forName "sci.impl.LibSciHost")
+        meth (.getMethod cls "registerCall" (into-array Class [String]))]
+    (.invoke meth nil (into-array Object [args-json]))))
+
+(defonce base-opts
+  {:namespaces {'cheshire.core
+                {'generate-string json/generate-string
+                 'parse-string    json/parse-string}}
+   :bindings {'host-call
+              (fn [& args]
+                (let [args-json (json/generate-string (vec args))]
+                  (register-host-call args-json)))}})
+
+(defn- get-or-init-ctx []
+  (if-let [ctx (get-ctx)]
+    ctx
+    (let [new-ctx (sci/init base-opts)]
+      (set-ctx! new-ctx)
+      new-ctx)))
+
+(defn -loadScript [s]
+  (sci/binding [sci/out *out*]
+    (try
+      (let [c      (get-or-init-ctx)
+            result (sci/eval-string* c s)]
+        (json/generate-string {:status "ok" :value (str result)}))
+      (catch Exception e
+        (json/generate-string
+          {:status "error" :error (str (type e)) :message (.getMessage e)})))))
+
+(defn -callFunction [fn-name args-edn]
+  (sci/binding [sci/out *out*]
+    (if-let [c (get-ctx)]
+      (try
+        (let [expr   (str "(" fn-name " " args-edn ")")
+              result (sci/eval-string* c expr)]
+          (json/generate-string {:status "ok" :value (str result)}))
+        (catch Exception e
+          (json/generate-string
+            {:status "error" :error (str (type e)) :message (.getMessage e)})))
+      (json/generate-string
+        {:status "error" :message "No context. Call load_script first."}))))
+
+(defn -evalInContext [s]
+  (sci/binding [sci/out *out*]
+    (if-let [c (get-ctx)]
+      (try
+        (let [result (sci/eval-string* c s)]
+          (json/generate-string {:status "ok" :value (str result)}))
+        (catch Exception e
+          (json/generate-string
+            {:status "error" :error (str (type e)) :message (.getMessage e)})))
+      (json/generate-string
+        {:status "error" :message "No context. Call load_script first."}))))
+
+(defn -resetContext []
+  (swap! contexts dissoc (.getId (Thread/currentThread))))
