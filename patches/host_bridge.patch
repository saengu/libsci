diff --git a/libsci/src/sci/impl/LibSciHost.java b/libsci/src/sci/impl/LibSciHost.java
new file mode 100644
index 0000000..2d840cd
--- /dev/null
+++ b/libsci/src/sci/impl/LibSciHost.java
@@ -0,0 +1,44 @@
+package sci.impl;
+
+import org.graalvm.nativeimage.c.function.CEntryPoint;
+import org.graalvm.nativeimage.c.function.CFunctionPointer;
+import org.graalvm.nativeimage.c.function.InvokeCFunctionPointer;
+import org.graalvm.nativeimage.c.type.CCharPointer;
+import org.graalvm.nativeimage.c.type.CTypeConversion;
+import org.graalvm.word.WordFactory;
+
+public final class LibSciHost {
+
+    public interface HostDispatcher extends CFunctionPointer {
+        @InvokeCFunctionPointer
+        CCharPointer execute(CCharPointer argPtr);
+    }
+
+    private static volatile long dispatcherPtr = 0;
+
+    @CEntryPoint(name = "set_host_dispatcher")
+    public static void setHostDispatcher(
+            @CEntryPoint.IsolateThreadContext long isolateId,
+            long fnPtr) {
+        dispatcherPtr = fnPtr;
+    }
+
+    public static String dispatchHostCall(String argsJson) {
+        long ptr = dispatcherPtr;
+        if (ptr == 0) {
+            return "{\"status\":\"error\","
+                 + "\"message\":\"No host dispatcher registered.\"}";
+        }
+        try {
+            CTypeConversion.CCharPointerHolder holder =
+                CTypeConversion.toCString(argsJson);
+            HostDispatcher disp = (HostDispatcher) WordFactory.pointer(ptr);
+            CCharPointer result = disp.execute(holder.get());
+            return CTypeConversion.toJavaString(result);
+        } catch (Exception e) {
+            return "{\"status\":\"error\","
+                 + "\"message\":\"dispatcher call failed: "
+                 + e.getMessage() + "\"}";
+        }
+    }
+}
diff --git a/libsci/src/sci/impl/libsci_host.clj b/libsci/src/sci/impl/libsci_host.clj
new file mode 100644
index 0000000..3ebec95
--- /dev/null
+++ b/libsci/src/sci/impl/libsci_host.clj
@@ -0,0 +1,179 @@
+(ns sci.impl.libsci-host
+  (:require [cheshire.core :as json]
+            [sci.core :as sci])
+  (:gen-class
+   :methods [^{:static true} [loadScript          [String] String]
+             ^{:static true} [callFunction        [String String] String]
+             ^{:static true} [evalInContext       [String] String]
+             ^{:static true} [resetContext        [] void]
+             ^{:static true} [registerNamespaces  [String] String]]))
+
+;; -- Per-thread context registry --
+
+(defonce contexts (atom {}))
+
+(defn- get-ctx []
+  (get @contexts (.getId (Thread/currentThread))))
+
+(defn- set-ctx! [ctx]
+  (swap! contexts assoc (.getId (Thread/currentThread)) ctx))
+
+;; -- Registered host namespaces --
+;; Stores registered namespace -> fn-name mappings.
+;; Structure: {"math" ["add" "subtract"], "io" ["read-file"]}
+;; Each fn-name is expanded into a SCI namespace binding at
+;; registration time via create-host-binding closures.
+
+(defonce registered-nss (atom {}))
+
+;; -- Reflection bridge to LibSciHost --
+;; Used instead of direct Java interop to avoid AOT dependency cycle
+;; between Clojure and Java sources.
+
+(defn- dispatch-host-call [args-json]
+  (try
+    (let [cls  (Class/forName "sci.impl.LibSciHost")
+          meth (.getMethod cls "dispatchHostCall" (into-array Class [String]))]
+      (.invoke meth nil (into-array Object [args-json])))
+    (catch Exception e
+      (str "{\"status\":\"error\",\"message\":\"Host bridge not available: "
+           (.getMessage e) "\"}"))))
+
+;; -- Closure factory for registered namespace functions --
+;; Creates a closure that captures ns-name and fn-name at registration
+;; time (static binding). When called from a SCI script, it constructs
+;; the unified JSON object format and dispatches through the host's
+;; C function pointer.
+
+(defn- create-host-binding [ns-name fn-name]
+  (fn [& args]
+    (let [call-json  (json/generate-string
+                       {"ns" ns-name
+                        "fn" fn-name
+                        "args" args})
+          raw-result (dispatch-host-call call-json)]
+      (if (string? raw-result)
+        (let [parsed (try (json/parse-string raw-result)
+                          (catch Exception e
+                            {"status" "error"
+                             "message" (str "Failed to parse host response: "
+                                           (.getMessage e))}))]
+          (if (= "ok" (get parsed "status"))
+            (get parsed "value")
+            (throw (ex-info (str "Host call failed: " (get parsed "message"))
+                            parsed))))
+        raw-result))))
+
+;; -- Build SCI namespace bindings from registration map --
+;; Transforms {"math" ["add" "subtract"]} into
+;; {'math {'add #<closure> 'subtract #<closure>}}
+
+(defn- build-ns-bindings [reg-nss]
+  (reduce-kv
+    (fn [m ns-name fns]
+      (assoc m (symbol ns-name)
+             (reduce (fn [bindings fn-name]
+                       (assoc bindings (symbol fn-name)
+                              (create-host-binding ns-name fn-name)))
+                     {}
+                     fns)))
+    {}
+    reg-nss))
+
+(defonce base-opts
+  {:namespaces {'cheshire.core
+                {'generate-string json/generate-string
+                 'parse-string    json/parse-string}}
+   :bindings {'host-call
+              (fn [fn-name & args]
+                (let [args-json  (json/generate-string
+                                   {"fn" (str fn-name)
+                                    "args" args})
+                      raw-result (dispatch-host-call args-json)]
+                  (if (string? raw-result)
+                    (try (json/parse-string raw-result true)
+                         (catch Exception e
+                           {:status "error"
+                            :message (str "Failed to parse host response: "
+                                          (.getMessage e))}))
+                    raw-result)))}})
+
+(defn- get-or-init-ctx
+  "Return current thread's context, creating one with base-opts
+  and any registered host namespaces."
+  []
+  (if-let [ctx (get-ctx)]
+    ctx
+    (let [merged-opts (if (seq @registered-nss)
+                        (update base-opts :namespaces
+                                merge (build-ns-bindings @registered-nss))
+                        base-opts)
+          new-ctx     (sci/init merged-opts)]
+      (set-ctx! new-ctx)
+      new-ctx)))
+
+(defn -registerNamespaces
+  "Register host-provided namespaces and functions into SCI.
+  Expects JSON: {\"namespaces\": {\"ns-name\": [\"fn1\", \"fn2\", ...]}}
+  Each registered function becomes transparently callable from Clojure
+  scripts as (ns-name/fn-name args...), routing through the host dispatcher."
+  [regs-json]
+  (try
+    (let [parsed (json/parse-string regs-json)
+          nss    (get parsed "namespaces")]
+      (if (and nss (map? nss))
+        (do
+          (reset! registered-nss nss)
+          (let [ns-bindings (build-ns-bindings nss)]
+            (doseq [[thread-id ctx] @contexts]
+              (swap! contexts update thread-id
+                     #(sci/merge-opts % {:namespaces ns-bindings}))))
+          (json/generate-string {:status "ok"
+                                 :message (str (count nss)
+                                               " namespace(s) registered")}))
+        (json/generate-string
+          {:status "error"
+           :message "Invalid format. Expected {\"namespaces\": {\"ns\": [\"fns\"]}}" })))
+    (catch Exception e
+      (json/generate-string
+        {:status "error"
+         :error (str (type e))
+         :message (.getMessage e)}))))
+
+(defn -loadScript [s]
+  (sci/binding [sci/out *out*]
+    (try
+      (let [c      (get-or-init-ctx)
+            result (sci/eval-string* c s)]
+        (json/generate-string {:status "ok" :value (str result)}))
+      (catch Exception e
+        (json/generate-string
+          {:status "error" :error (str (type e)) :message (.getMessage e)})))))
+
+(defn -callFunction [fn-name args-edn]
+  (sci/binding [sci/out *out*]
+    (if-let [c (get-ctx)]
+      (try
+        (let [expr   (str "(" fn-name " " args-edn ")")
+              result (sci/eval-string* c expr)]
+          (json/generate-string {:status "ok" :value (str result)}))
+        (catch Exception e
+          (json/generate-string
+            {:status "error" :error (str (type e)) :message (.getMessage e)})))
+      (json/generate-string
+        {:status "error" :message "No context. Call load_script first."}))))
+
+(defn -evalInContext [s]
+  (sci/binding [sci/out *out*]
+    (if-let [c (get-ctx)]
+      (try
+        (let [result (sci/eval-string* c s)]
+          (json/generate-string {:status "ok" :value (str result)}))
+        (catch Exception e
+          (json/generate-string
+            {:status "error" :error (str (type e)) :message (.getMessage e)})))
+      (json/generate-string
+        {:status "error" :message "No context. Call load_script first."}))))
+
+(defn -resetContext []
+  (swap! contexts dissoc (.getId (Thread/currentThread))))
